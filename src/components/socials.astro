import linkedinIcon from "@/assets/linkedin.png";
import xIcon from "@/assets/x.svg";
---

<div class="flex gap-2 items-center">
  <a href="https://github.com/owenkrause" target="_blank">
    <img
      src={githubIcon.src}
      width="16"
      height="16"
    />
  </a>
  <a href="https://x.com/oh1hn" target="_blank">
    <img
      src={xIcon.src}
      width="16"
      height="16"
    />
  </a>
  <a href="https://www.linkedin.com/in/owen-krause/" target="_blank">
    <img
      src={linkedinIcon.src}
      width="16"
      height="16"
    />
  </a>
</div>