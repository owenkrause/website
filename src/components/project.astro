---
import githubIcon from "@/assets/github.svg";
import websiteIcon from "@/assets/website.svg";

interface Props {
	title: string;
	description: string;
  github?: {
    owner: string,
    repo: string
  },
	urls?: {
		deployment?: string;
    misc?: string
	};
}

const { title, description, github, urls } = Astro.props;
---

<div class="carousel-item card bg-base-100 w-xs shadow-sm">
  <figure>
    <a href={`https://github.com/${github?.owner}/${github?.repo}`} target="_blank">
      <img
        src={`https://opengraph.githubassets.com/1/${github?.owner}/${github?.repo}`}
        alt="GitHub Preview"
      />
    </a>
  </figure>
</div>