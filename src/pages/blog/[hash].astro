---
import type { GetStaticPaths } from "astro";
import blockchain from "@/data/blockchain.json";

export const getStaticPaths = (() => {
  return blockchain.map(block => ({
    params: { hash: block.hash },
    props: { block }
  }));
}) satisfies GetStaticPaths;

const { block } = Astro.props;
---

<html>
  <head>
    <title>oh1 | {block.title}</title>
  </head>
  <body>
    <article>
      <h1>{block.title}</h1>
      <time datetime={new Date(block.timestamp).toISOString()}>
        {new Date(block.timestamp).toLocaleString()}
      </time>
      <div>{block.content}</div>
      <div>- {block.author}</div>
      <footer>
        <p>Hash: <code>{block.hash}</code></p>
        <p>Previous: <code>{block.prevHash}</code></p>
        {block.prevHash !== '0'.repeat(64) && (
          <a href={`/blog/${block.prevHash}`}>← Previous Post</a>
        )}
      </footer>
    </article>
  </body>
</html>