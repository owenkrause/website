---
import Layout from '@/layouts/layout.astro';
import blockchain from '@/data/blockchain.json';

const posts = blockchain.sort((a, b) => b.timestamp - a.timestamp);
---

<Layout
  title="oh1 | blogchain directory"
  bodyClass="flex flex-col w-full h-full m-0 font-mono text-black/90 overflow-auto"
>
  <div class="p-8 max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold mb-6">blogchain directory</h1>
    <ul class="space-y-4">
      {posts.map(post => (
        <li class="border-b border-gray-200 pb-4">
          <a href={`/blog/${post.hash}`} class="text-blue-600 underline hover:text-blue-800 text-lg">
            {post.title}
          </a>
          <br />
          <small class="text-gray-600">
            by {post.author} - {new Date(post.timestamp).toLocaleDateString()}
          </small>
        </li>
      ))}
    </ul>
  </div>
</Layout>
