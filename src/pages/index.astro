---
import Socials from "@/components/socials.astro";
import Layout from "@/layouts/layout.astro";
---

<Layout>
  <div class="flex flex-col w-screen items-center">
    <div class="px-4 py-8 max-w-2xl font-mono">
      <!-- header -->
      <h1 class="text-2xl font-bold mb-2">owen krause</h1>
      <p class="text-gray-600 mb-1">aka oh1 (oh-one)</p>
      <p class="text-gray-700 mb-6">CS @ Oregon State</p>

      <!-- quick intro -->
      <div class="mb-8 bg-gray-50 p-4 rounded border border-gray-200">
        <p class="text-sm leading-relaxed">
          Passionate about building impactful things.
        </p>
      </div>

      <!-- navigation tree -->
      <nav class="space-y-1 mb-8">
        <div>
          <span class="text-gray-500">┌──</span>
          <a
            href="/resume_backend.pdf"
            class="text-blue-600 underline hover:text-blue-800"
          >
            resume
          </a>
        </div>

        <div>
          <span class="text-gray-500">├──</span>
          <a
            href="/projects"
            class="text-blue-600 underline hover:text-blue-800"
          >
            projects
          </a>
        </div>

        <div>
          <span class="text-gray-500">└──</span>
          <a href="/blog" class="text-blue-600 underline hover:text-blue-800">
            blog
          </a>
        </div>
      </nav>

      <!-- featured/recent -->
      <div class="mb-8">
        <h2 class="text-sm font-semibold text-gray-500 uppercase mb-3">
          Recent
        </h2>
        <ul class="space-y-2 text-sm">
          <li>
            <span class="text-gray-500">•</span>
            <span class="text-gray-700"
              >Scaling BeaverHacks from 50 → 300 attendees</span
            >
          </li>
          <li>
            <span class="text-gray-500">•</span>
            <span class="text-gray-700"
              >1st place Cal Hacks 11.0 · 3rd Sui Overflow 2025</span
            >
          </li>
          <li>
            <span class="text-gray-500">•</span>
            <span class="text-gray-700"
              >Building NVMe KV storage engine (capstone)</span
            >
          </li>
        </ul>
      </div>

      <!-- socials -->
      <Socials />
    </div>
  </div>
</Layout>
