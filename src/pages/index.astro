---
import Layout from "@/layouts/layout.astro";
import { timeline } from "@/data/timeline";
---

<Layout title="owen krause">
  <div class="w-full max-w-xl mx-auto px-6 py-15">
    <h1 class="text-xl font-semibold text-gray-600 mb-1">owen krause</h1>
    <p class="text-sm text-gray-400 mb-3.5">
      oh1 · cs + math @ oregon state university
    </p>
    <p class="text-sm text-gray-600 mb-4">coding and maxxing out life</p>
    <div class="text-sm mb-8">
      <a
        href="https://github.com/owenkrause"
        target="_blank"
        class="text-[#0000EE] underline">github</a
      ><span class="text-gray-600 mx-1.5">·</span><a
        href="/resume.pdf"
        target="_blank"
        class="text-[#0000EE] underline">resume</a
      ><span class="text-gray-600 mx-1.5">·</span><a
        href="https://www.linkedin.com/in/owen-krause/"
        target="_blank"
        class="text-[#0000EE] underline">linkedin</a
      >
    </div>

    <p class="text-sm text-gray-400 mb-3">things i've done ~</p>

    {
      timeline.map((entry) => (
        <div
          class="entry group/entry border-b border-gray-100 last:border-b-0"
          data-has-detail={entry.detail ? "true" : undefined}
        >
          <div
            class:list={[
              "flex justify-between items-baseline text-sm leading-normal py-2",
              { "cursor-pointer select-none group": !!entry.detail },
            ]}
          >
            <div>
              <strong class="font-semibold text-gray-600">{entry.title}</strong>{" "}
              <span class="text-gray-500">— {entry.description}</span>
            </div>
            {entry.detail ? (
              <div class="flex items-baseline">
                <span class="text-gray-300 text-xs shrink-0 ml-3">
                  {entry.date}
                </span>
              </div>
            ) : (
              <span class="text-gray-300 text-xs shrink-0 ml-3">
                {entry.date}
              </span>
            )}
          </div>
          {entry.detail && (
            <div class="max-h-0 overflow-hidden transition-all duration-250 ease-in-out group-[.open]/entry:max-h-50">
              <div class="text-xs text-gray-600 leading-relaxed pt-0.5 pb-3">
                {entry.detail.text}
                {entry.detail.links && entry.detail.links.length > 0 && (
                  <div class="mt-2 flex gap-3">
                    {entry.detail.links.map((link) => (
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs text-[#0000EE] underline"
                        onclick="event.stopPropagation()"
                      >
                        {link.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          )}
        </div>
      ))
    }

    <div class="mt-8 border border-gray-200 p-5">
      <h2
        class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3"
      >
        Motivations
      </h2>
      <p class="text-xs text-gray-600 leading-relaxed">
        if i knew i only had one shot, i'd do everything i possibly could to
        make it the best shot. "suck the bone marrow out of life" - Thoreau. i
        came across this quote in 7th grade and it has always stuck with me.
        <br /><br />
        i'm stubborn about following my own path. i skipped AP classes to scale a
        reselling business. i built projects instead of grinding leetcode. result:
        i didn't get into a top school or secure a faang internship. but i'd rather
        bet on myself than follow a script.
        <br /><br />
        my lowest point came after my first real failure — betting on myself didn't
        pay off. but i realized my identity isn't the outcome, it's the process. build,
        fail, try again, grow. that loop is what makes me feel alive.
      </p>
    </div>
  </div>

  <footer
    class="bg-gray-50 border-t border-gray-200 py-4 text-center text-xs text-gray-400"
  >
    owen krause · 2026
  </footer>

  <script>
    function toggle(el: Element) {
      const wasOpen = el.classList.contains("open");
      document
        .querySelectorAll(".entry.open")
        .forEach((e) => e.classList.remove("open"));
      if (!wasOpen) el.classList.add("open");
    }

    document.querySelectorAll(".entry[data-has-detail]").forEach((entry) => {
      entry.addEventListener("click", () => toggle(entry));
    });
  </script>
</Layout>
